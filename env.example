# GrowTogether Environment Configuration
# Copy this file to `.env` in the root folder to customize your environment.
# Note: The app includes full built-in demo mode and test accounts, so it runs
# out-of-the-box even without active external backend keys!

# Supabase Backend Configuration
# (Found in Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth Configuration (Optional - for production Google Sign-In)
# (Found in Google Cloud Console -> APIs & Services -> Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id

# AI Processing Configuration (Optional - for future smart matching)
EXPO_PUBLIC_DEEPSEEK_API_KEY=your_deepseek_api_key

# App Environment Configuration
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://your-api-url.com

# EAS Build Configuration
EAS_PROJECT_ID=your_eas_project_id

